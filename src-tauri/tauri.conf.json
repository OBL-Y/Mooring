{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mooring",
  "version": "0.1.0",
  "identifier": "io.github.obl-y.mooring",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Mooring",
        "width": 560,
        "height": 680,
        "minWidth": 480,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "Restores window positions when you redock",
    "longDescription": "Mooring remembers where your windows (and, on Windows, desktop icons) sit for each display setup, and puts them back when you dock or undock your laptop.",
    "copyright": "Copyright (c) 2026 OBL-Y",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}

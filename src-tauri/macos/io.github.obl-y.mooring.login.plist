<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Registered by 0.1.0-beta.5 only. Kept in the bundle so login.rs can unregister it
     (SMAppService needs the plist present); remove once testers are past beta.5. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.obl-y.mooring.login</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/mooring</string>
  <key>ProgramArguments</key>
  <array>
    <string>mooring</string>
    <string>--autostart</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>io.github.obl-y.mooring</string>
  </array>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
